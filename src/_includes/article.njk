---
layout: base.njk
---
<article class="article">
  <div class="wrap">
    <p class="article-date">{{ page.date | readableDate }}</p>
    <h1>{{ title }}</h1>
    {{ content | safe }}
    <div class="article-cta">
      <a class="cta" href="/#booking">
        <span>Book a 15 minute call</span>
      </a>
    </div>
  </div>
</article>
